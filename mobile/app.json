{
  "expo": {
    "name": "FitCare",
    "slug": "fitcare-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fitcare",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.fitcare.mobile",
      "usesCleartextTraffic": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitcare.mobile"
    },
    "plugins": [
      [
        "react-native-health-connect",
        {
          "permissions": [
            "HeartRate",
            "ActiveCaloriesBurned"
          ]
        }
      ],
      "react-native-ble-plx",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1698c1db-f1d2-4255-b1dc-d59735079859"
      }
    }
  }
}